# Kopiere diese Datei zu ".env" und trage deinen eigenen Anthropic API-Key ein.
# Den Key NIEMALS committen oder teilen.
ANTHROPIC_API_KEY=

# Port des Backends im DEV-Modus. Bewusst kein generischer Name wie "PORT", da
# lokale Dev-/Preview-Tools diese Variable oft schon fuer den Frontend-Port setzen.
# Nur fuer lokale Entwicklung noetig - in Production (z. B. Railway) wird
# automatisch die von der Plattform vergebene PORT-Variable verwendet.
LUMO_API_PORT=3001
